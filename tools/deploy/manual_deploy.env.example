# Settings for tools/deploy/manual_deploy.sh. Copy to manual_deploy.env (gitignored) and fill
# in. They match the GitHub secrets of the same purpose (Settings → Secrets → Actions).

# SSH access to the VPS (GitHub secrets SSH_HOST, SSH_USER, SSH_PORT, DEPLOY_PATH).
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22
DEPLOY_PATH=
# Private key for that user; leave empty to use your SSH agent / ~/.ssh/config.
DEPLOY_SSH_KEY=~/.ssh/akilent_deploy

# Public address, for the final outside health check and the Cloudflare purge.
SITE_URL=https://akilent.com

# Optional: confirm CI passed for the commit through the GitHub API (when GitHub answers).
# A fine-grained token with read access to Actions on this repository.
GITHUB_REPO=owner/repo
GITHUB_TOKEN=

# Optional: purge the cached landing page (GitHub secrets CLOUDFLARE_ZONE_ID, CLOUDFLARE_API_TOKEN).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
