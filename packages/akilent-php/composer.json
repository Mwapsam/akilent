{
  "name": "akilent/akilent",
  "description": "Official PHP SDK for the Akilent email API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "Akilent\\": "src/" },
    "files": [ "src/Errors.php" ]
  },
  "autoload-dev": {
    "psr-4": { "Akilent\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  }
}
